# Backend settings (copy to backend/.env for local development)
PORT=3001
DASHBOARD_API_KEY=changeme123
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# SQLite file; default is backend/db/smartforms.db. Relative paths use the working directory.
# DB_PATH=./db/smartforms.db

# External origin used in notification links. Set to your HTTPS origin in production.
# PUBLIC_BASE_URL=http://localhost:5173

# Notifications are disabled unless both SMTP_HOST and NOTIFY_TO are set.
# The relay must support STARTTLS (SMTP_SECURE=false, usually port 587)
# or implicit TLS (SMTP_SECURE=true, usually port 465). No plaintext fallback.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_FROM=intake@example.com
# NOTIFY_TO=office@example.com
